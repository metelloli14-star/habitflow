# Скопируйте в .env.local и заполните. Без этих настроек в режиме разработки работают имитации
# (письма — в консоль сервера, VK ID — тестовый аккаунт).

# ---- База данных PostgreSQL (обязательно) ----
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Спецсимволы в пароле (@ : / ? # %) нужно закодировать, проще сгенерировать пароль без них: openssl rand -hex 24
DATABASE_URL=postgresql://habitflow:ПАРОЛЬ@127.0.0.1:5432/habitflow

# ---- Письма с кодами (SMTP российского сервиса: адреса пользователей не уходят за рубеж) ----
# Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения из id.yandex.ru → Безопасность → Пароли приложений
# Mail.ru: smtp.mail.ru, порт 465
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@poleznyeprivychki.ru
SMTP_PASS=
MAIL_FROM="Привычка <no-reply@poleznyeprivychki.ru>"

# ---- Push-напоминания на телефон (Web Push) ----
# Ключи создаются один раз командой `npm run push:keys` (Public Key и Private Key).
# Не меняйте их без необходимости: с новыми ключами все устройства придётся подписывать заново.
# Без ключей кнопка «Уведомления» в личном кабинете не работает, остальное приложение — как обычно.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@poleznyeprivychki.ru

# ---- Аналитика: Яндекс Метрика (по желанию) ----
# Номер счётчика из metrika.yandex.ru. Задайте ДО `npm run build` — он встраивается при сборке.
# Метрика загружается только после согласия посетителя в баннере о cookie. Пусто — аналитики и баннера нет.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ---- Вход через VK ID (кабинет id.vk.ru, вход через VK Бизнес ID) ----
VK_ID_CLIENT_ID=
VK_ID_REDIRECT_URI=https://poleznyeprivychki.ru/api/auth/vk/callback
