# Скопируйте в .env.local и заполните. Без этих настроек в режиме разработки работают имитации
# (письма — в консоль сервера, VK ID — тестовый аккаунт).

# ---- Письма с кодами (SMTP российского сервиса: адреса пользователей не уходят за рубеж) ----
# Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения из id.yandex.ru → Безопасность → Пароли приложений
# Mail.ru: smtp.mail.ru, порт 465
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@poleznyeprivychki.ru
SMTP_PASS=
MAIL_FROM="Привычка <no-reply@poleznyeprivychki.ru>"

# ---- Вход через VK ID (кабинет id.vk.ru, вход через VK Бизнес ID) ----
VK_ID_CLIENT_ID=
VK_ID_REDIRECT_URI=https://poleznyeprivychki.ru/api/auth/vk/callback
